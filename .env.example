# AI Workplace Productivity Assistant - environment configuration
# Copy to .env and fill in. All values are optional: with no key the app runs in DEMO MODE.

# OpenAI-compatible base URL (no trailing slash).
# Default: https://ai.gateway.lovable.dev/v1
AI_API_URL=https://ai.gateway.lovable.dev/v1

# API key for the endpoint above. Server-side only - never prefix with VITE_.
AI_API_KEY=

# Model identifier.
# Default: openai/gpt-6-astra
AI_MODEL=openai/gpt-6-astra
